rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/perfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/perfiles/$(request.auth.uid)).data.activo == true;
    }

    function isAdmin() {
      return activeProfile()
        && get(/databases/$(database)/documents/perfiles/$(request.auth.uid)).data.rol == 'administrador';
    }

    function isSeller() {
      return activeProfile()
        && get(/databases/$(database)/documents/perfiles/$(request.auth.uid)).data.rol == 'vendedor';
    }

    match /perfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll([
            'uid', 'nombre', 'correo', 'rol', 'activo', 'creadoEn'
          ])
          && request.resource.data.keys().hasOnly([
            'uid', 'nombre', 'correo', 'rol', 'activo', 'creadoEn'
          ])
          && request.resource.data.uid == uid
          && request.resource.data.rol == 'vendedor'
          && request.resource.data.activo == true
          && request.resource.data.nombre is string
          && request.resource.data.correo is string
          && request.resource.data.creadoEn is timestamp
        );
      allow update, delete: if isAdmin();
    }

    match /productos/{productoId} {
      allow read: if isSeller() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /cotizaciones/{cotizacionId} {
      allow read: if isAdmin()
        || (isSeller() && resource.data.vendedorUid == request.auth.uid);
      allow create: if isAdmin()
        || (isSeller() && request.resource.data.vendedorUid == request.auth.uid);
      allow update: if isAdmin()
        || (
          isSeller()
          && resource.data.vendedorUid == request.auth.uid
          && request.resource.data.vendedorUid == request.auth.uid
        );
      allow delete: if isAdmin();
    }
  }
}
