<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820"
    android:orientation="vertical">

    <TextView
        android:id="@+id/screen_back"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:text="‹   HISTORIAL DE COTIZACIONES"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView android:layout_width="match_parent" android:layout_height="4dp" android:background="#F2B705" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <EditText android:layout_width="match_parent" android:layout_height="42dp" android:background="#1B252E" android:hint="Buscar por cliente o folio..." android:padding="10dp" android:textColor="#FFFFFF" android:textColorHint="#78848D" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Spinner android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="#1B252E" android:prompt="@string/all_salespeople" />
                <Spinner android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="#1B252E" android:prompt="@string/last_30_days" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="10dp" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="#1B252E" android:gravity="center" android:text="$85,400&#10;Total cotizado" android:textColor="#F2B705" android:textSize="11sp" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="#1B252E" android:gravity="center" android:text="27&#10;Cotizaciones" android:textColor="#52D273" android:textSize="11sp" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="#1B252E" android:gravity="center" android:text="42%&#10;Conversión" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="#1B252E" android:padding="12dp" android:text="COT-0042&#10;FERRETERÍA CENTRAL S.A.                  Aprobada&#10;Varilla corrugada 3/8” · 20 piezas&#10;Vendedor: Juan Pérez                         $28,500.00" android:textColor="#D6DCE0" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#1B252E" android:padding="12dp" android:text="COT-0041&#10;CONSTRUCTORA DEL NORTE                    Vigente&#10;Lámina galvanizada · 15 piezas&#10;Vendedor: Ana López                          $18,945.00" android:textColor="#D6DCE0" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#1B252E" android:padding="12dp" android:text="COT-0040&#10;TALLERES RIVERA                              Por revisar&#10;Ángulo de acero · 8 piezas&#10;Vendedor: Juan Pérez                          $8,680.00" android:textColor="#D6DCE0" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#1B252E" android:padding="12dp" android:text="COT-0039&#10;ACEROS Y PERFILES DEL SUR                    Expirada&#10;Canal monten · 12 piezas&#10;Vendedor: Ana López                          $16,200.00" android:textColor="#AAB4BC" android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:background="#141D25" android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/nav_inicio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Inicio" android:textColor="#AAB4BC" android:textSize="11sp" />
        <TextView android:id="@+id/nav_cotizaciones" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Cotizaciones" android:textColor="#F2B705" android:textSize="11sp" />
        <TextView android:id="@+id/nav_inventario" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Inventario" android:textColor="#AAB4BC" android:textSize="11sp" />
        <TextView android:id="@+id/nav_reportes" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Reportes" android:textColor="#AAB4BC" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
