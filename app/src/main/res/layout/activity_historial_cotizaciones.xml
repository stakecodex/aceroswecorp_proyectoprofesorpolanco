<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10161D"
    android:orientation="vertical">

    <include layout="@layout/include_screen_header" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:text="HISTORIAL DE COTIZACIONES"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <EditText android:layout_width="match_parent" android:layout_height="42dp" android:background="@drawable/bg_campo" android:hint="Buscar por cliente o folio..." android:padding="10dp" android:textColor="#FFFFFF" android:textColorHint="#6F7C89" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Spinner android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/bg_campo" android:prompt="@string/all_salespeople" />
                <Spinner android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/bg_campo" android:prompt="@string/last_30_days" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="10dp" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/bg_tarjeta" android:gravity="center" android:text="$85,400&#10;Total cotizado" android:textColor="#F0821E" android:textSize="11sp" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/bg_tarjeta" android:gravity="center" android:text="27&#10;Cotizaciones" android:textColor="#52D273" android:textSize="11sp" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/bg_tarjeta" android:gravity="center" android:text="42%&#10;Conversión" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_tarjeta" android:padding="12dp" android:text="COT-0042 · Aprobada&#10;FERRETERÍA CENTRAL S.A.&#10;Varilla corrugada 3/8” · 20 piezas&#10;Juan Pérez · $28,500.00" android:textColor="#D6DCE0" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_tarjeta" android:padding="12dp" android:text="COT-0041 · Vigente&#10;CONSTRUCTORA DEL NORTE&#10;Lámina galvanizada · 15 piezas&#10;Ana López · $18,945.00" android:textColor="#D6DCE0" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_tarjeta" android:padding="12dp" android:text="COT-0040 · Por revisar&#10;TALLERES RIVERA&#10;Ángulo de acero · 8 piezas&#10;Juan Pérez · $8,680.00" android:textColor="#D6DCE0" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_tarjeta" android:padding="12dp" android:text="COT-0039 · Expirada&#10;ACEROS Y PERFILES DEL SUR&#10;Canal monten · 12 piezas&#10;Ana López · $16,200.00" android:textColor="#8C98A4" android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:background="#0A0F14" android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/nav_inicio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Inicio" android:textColor="#8C98A4" android:textSize="11sp" />
        <TextView android:id="@+id/nav_cotizaciones" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Cotizaciones" android:textColor="#F0821E" android:textSize="11sp" />
        <TextView android:id="@+id/nav_inventario" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Inventario" android:textColor="#8C98A4" android:textSize="11sp" />
        <TextView android:id="@+id/nav_reportes" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Reportes" android:textColor="#8C98A4" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
