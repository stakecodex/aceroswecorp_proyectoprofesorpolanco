<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/screen_back"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#1B252E"
            android:contentDescription="@string/back"
            android:gravity="start|center_vertical"
            android:paddingStart="14dp"
            android:text="@string/back_arrow"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="H  ACEROS WE-CORP"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="DISTRIBUIDORA DE ACERO"
            android:textColor="#F2B705"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:background="#1B252E"
            android:padding="20dp"
            android:text="Explorar la aplicación"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B252E"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp"
            android:text="Firebase aún no está configurado. Selecciona un menú para probar la navegación; este modo no inicia sesión ni guarda información."
            android:textColor="#AAB4BC"
            android:textSize="13sp" />

        <Button
            android:id="@+id/button_enter_sales"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#D95708"
            android:text="EXPLORAR COMO VENDEDOR"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_enter_admin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#1B252E"
            android:text="EXPLORAR COMO ADMINISTRADOR"
            android:textColor="#F2B705"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="La autenticación real se conectará en otro hito."
            android:textColor="#AAB4BC"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
