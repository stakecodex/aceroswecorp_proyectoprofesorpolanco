<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10161D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="56dp"
        android:paddingEnd="28dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo_wecorp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.04"
                android:text="ACEROS WE-CORP"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.34"
            android:text="BARRACA DE ACERO"
            android:textColor="#F0821E"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:text="Aplicación móvil de cotizaciones"
            android:textColor="#A9B4BF"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginStart="-28dp"
            android:layout_marginTop="36dp"
            android:layout_marginEnd="-28dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/franja_seguridad" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_tarjeta"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/edit_correo"
                android:text="Correo electrónico"
                android:textColor="#A9B4BF"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edit_correo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_campo"
                android:hint="usuario@aceroswecorp.cl"
                android:inputType="textEmailAddress"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6F7C89"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:labelFor="@+id/edit_contrasena"
                android:text="Contraseña"
                android:textColor="#A9B4BF"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edit_contrasena"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_campo"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6F7C89"
                android:textSize="15sp" />

            <Button
                android:id="@+id/button_ingresar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#C2570E"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.08"
                android:text="INGRESAR AL SISTEMA"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="6dp" />

            <TextView
                android:id="@+id/text_recuperar"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="¿Olvidaste tu contraseña?"
                android:textColor="#F0821E"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/button_crear_cuenta"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#1A222B"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.08"
            android:text="CREAR CUENTA"
            android:textColor="#F0821E"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="6dp"
            app:strokeColor="#333F4B"
            app:strokeWidth="1dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Versión 1.0 — 2026"
            android:textColor="#6F7C89"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="Powered by Kronovex"
            android:textColor="#6F7C89"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
