<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10161D"
    android:orientation="vertical">

    <include layout="@layout/include_screen_header" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:text="VENTAS Y DOCUMENTOS"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <EditText android:layout_width="match_parent" android:layout_height="42dp" android:background="@drawable/bg_campo" android:hint="Buscar por cliente o documento..." android:padding="10dp" android:textColor="#FFFFFF" android:textColorHint="#6F7C89" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="10dp" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/bg_tarjeta" android:gravity="center" android:text="$432,800&#10;Ventas del mes" android:textColor="#F0821E" android:textSize="11sp" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/bg_tarjeta" android:gravity="center" android:text="$78,225&#10;Por cobrar" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_tarjeta" android:padding="12dp" android:text="VT-0048 · Pagado&#10;FERRETERÍA CENTRAL S.A.&#10;Factura · 04/06/2026 · FAC-2831&#10;$28,500.00" android:textColor="#D6DCE0" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_tarjeta" android:padding="12dp" android:text="VT-0047 · Pendiente&#10;CONSTRUCTORA DEL NORTE&#10;Remisión · 03/06/2026 · REM-1924&#10;$18,945.00" android:textColor="#D6DCE0" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_tarjeta" android:padding="12dp" android:text="VT-0046 · Pagado&#10;TALLERES RIVERA&#10;Factura · 02/06/2026 · FAC-2830&#10;$8,680.00" android:textColor="#D6DCE0" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_tarjeta" android:padding="12dp" android:text="VT-0045 · Pendiente&#10;ACEROS Y PERFILES DEL SUR&#10;Remisión · 01/06/2026 · REM-1923&#10;$16,200.00" android:textColor="#D6DCE0" android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:background="#0A0F14" android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/nav_inicio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Inicio" android:textColor="#8C98A4" android:textSize="11sp" />
        <TextView android:id="@+id/nav_cotizaciones" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Cotizaciones" android:textColor="#8C98A4" android:textSize="11sp" />
        <TextView android:id="@+id/nav_inventario" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Inventario" android:textColor="#8C98A4" android:textSize="11sp" />
        <TextView android:id="@+id/nav_ventas" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Ventas" android:textColor="#F0821E" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
