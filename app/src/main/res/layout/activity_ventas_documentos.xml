<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:text="‹   VENTAS Y DOCUMENTOS"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView android:layout_width="match_parent" android:layout_height="4dp" android:background="#F2B705" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <EditText android:layout_width="match_parent" android:layout_height="42dp" android:background="#1B252E" android:hint="Buscar por cliente o documento..." android:padding="10dp" android:textColor="#FFFFFF" android:textColorHint="#78848D" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="10dp" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="#1B252E" android:gravity="center" android:text="$432,800&#10;Ventas del mes" android:textColor="#F2B705" android:textSize="11sp" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="#1B252E" android:gravity="center" android:text="$78,225&#10;Por cobrar" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="#1B252E" android:padding="12dp" android:text="VT-0048&#10;FERRETERÍA CENTRAL S.A.                Pagado&#10;Factura · 04/06/2026&#10;Folio: FAC-2831                                 $28,500.00" android:textColor="#D6DCE0" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#1B252E" android:padding="12dp" android:text="VT-0047&#10;CONSTRUCTORA DEL NORTE                 Pendiente&#10;Remisión · 03/06/2026&#10;Folio: REM-1924                                 $18,945.00" android:textColor="#D6DCE0" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#1B252E" android:padding="12dp" android:text="VT-0046&#10;TALLERES RIVERA                              Pagado&#10;Factura · 02/06/2026&#10;Folio: FAC-2830                                  $8,680.00" android:textColor="#D6DCE0" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#1B252E" android:padding="12dp" android:text="VT-0045&#10;ACEROS Y PERFILES DEL SUR                Pendiente&#10;Remisión · 01/06/2026&#10;Folio: REM-1923                                 $16,200.00" android:textColor="#D6DCE0" android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:background="#141D25" android:gravity="center" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Inicio" android:textColor="#AAB4BC" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Cotizaciones" android:textColor="#AAB4BC" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Inventario" android:textColor="#AAB4BC" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Ventas" android:textColor="#F2B705" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
