<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10161D"
    android:orientation="vertical">

    <include layout="@layout/include_screen_header" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:text="NUEVA COTIZACIÓN"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CLIENTE" android:textColor="#F0821E" android:textSize="11sp" android:textStyle="bold" />
            <EditText
                android:id="@+id/input_quote_client"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_campo"
                android:hint="Nombre del cliente"
                android:inputType="textCapWords"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6F7C89"
                android:textSize="13sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="PRODUCTO / PRESENTACIÓN" android:textColor="#F0821E" android:textSize="11sp" android:textStyle="bold" />
            <Spinner
                android:id="@+id/spinner_quote_products"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_campo" />

            <EditText
                android:id="@+id/input_quote_quantity"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_campo"
                android:hint="Cantidad"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6F7C89"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/quote_product_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tarjeta"
                android:padding="12dp"
                android:text="Selecciona un producto y una cantidad"
                android:textColor="#8C98A4"
                android:textSize="12sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="DESCRIPCIÓN / NOTAS" android:textColor="#F0821E" android:textSize="11sp" android:textStyle="bold" />
            <EditText
                android:id="@+id/input_quote_notes"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_campo"
                android:gravity="top"
                android:hint="Agregar notas..."
                android:inputType="textCapSentences|textMultiLine"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6F7C89"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/quote_final_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_tarjeta"
                android:padding="14dp"
                android:text="TOTAL CON IVA"
                android:textColor="#F0821E"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_save_quote"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#C2570E"
                android:text="GUARDAR COTIZACIÓN"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:background="#0A0F14" android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/nav_inicio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Inicio" android:textColor="#8C98A4" android:textSize="11sp" />
        <TextView android:id="@+id/nav_clientes" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Clientes" android:textColor="#8C98A4" android:textSize="11sp" />
        <TextView android:id="@+id/nav_inventario" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Inventario" android:textColor="#8C98A4" android:textSize="11sp" />
        <TextView android:id="@+id/nav_cotizaciones" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Cotizaciones" android:textColor="#F0821E" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
