<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#101820"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/screen_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:backgroundTint="#1B252E"
            android:contentDescription="@string/back"
            android:text="@string/back_arrow"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="NUEVA COTIZACIÓN"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="4dp" android:background="#F2B705" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CLIENTE" android:textColor="#F2B705" android:textSize="11sp" android:textStyle="bold" />
            <Spinner android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="#1B252E" android:prompt="@string/select_client" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="PRODUCTO / PRESENTACIÓN" android:textColor="#F2B705" android:textSize="11sp" android:textStyle="bold" />
            <EditText android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="#1B252E" android:hint="Buscar producto..." android:padding="12dp" android:textColor="#FFFFFF" android:textColorHint="#78848D" android:textSize="13sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="#1B252E" android:padding="12dp" android:text="Varilla corrugada 3/8”  ·  $230.00" android:textColor="#D6DCE0" android:textSize="13sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#1B252E" android:padding="12dp" android:text="Cantidad: 10 piezas · $2,300.00" android:textColor="#AAB4BC" android:textSize="12sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="DESCRIPCIÓN / NOTAS" android:textColor="#F2B705" android:textSize="11sp" android:textStyle="bold" />
            <EditText android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="6dp" android:background="#1B252E" android:gravity="top" android:hint="Agregar notas..." android:padding="12dp" android:textColor="#FFFFFF" android:textColorHint="#78848D" android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="#1B252E"
                android:padding="14dp"
                android:text="TOTAL CON IVA · $2,668.00"
                android:textColor="#F2B705"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_save_quote"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#D95708"
                android:text="GUARDAR COTIZACIÓN"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:background="#141D25" android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/nav_inicio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Inicio" android:textColor="#AAB4BC" android:textSize="11sp" />
        <TextView android:id="@+id/nav_clientes" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Clientes" android:textColor="#AAB4BC" android:textSize="11sp" />
        <TextView android:id="@+id/nav_inventario" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Inventario" android:textColor="#AAB4BC" android:textSize="11sp" />
        <TextView android:id="@+id/nav_cotizaciones" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Cotizaciones" android:textColor="#F2B705" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
