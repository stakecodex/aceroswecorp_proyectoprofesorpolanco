<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/input_product_name"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_campo"
            android:hint="Nombre del producto"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#6F7C89" />

        <EditText
            android:id="@+id/input_product_code"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_campo"
            android:hint="Código"
            android:inputType="textCapCharacters"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#6F7C89" />

        <EditText
            android:id="@+id/input_product_category"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_campo"
            android:hint="Categoría"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#6F7C89" />

        <EditText
            android:id="@+id/input_product_unit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_campo"
            android:hint="Unidad (pieza, kg...)"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#6F7C89" />

        <EditText
            android:id="@+id/input_product_stock"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_campo"
            android:hint="Existencia"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#6F7C89" />

        <EditText
            android:id="@+id/input_product_price"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_campo"
            android:hint="Precio unitario"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#6F7C89" />
    </LinearLayout>
</ScrollView>
