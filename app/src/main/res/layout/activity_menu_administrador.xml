<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10161D"
    android:orientation="vertical">

    <include layout="@layout/include_screen_header" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:text="Menú Administrador"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="68dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_tarjeta" android:gravity="center_vertical" android:padding="12dp" android:text="18&#10;Cotizaciones pendientes" android:textColor="#C2570E" android:textSize="12sp" />
                <TextView android:layout_width="0dp" android:layout_height="68dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_tarjeta" android:gravity="center_vertical" android:padding="12dp" android:text="4&#10;Usuarios activos" android:textColor="#F0821E" android:textSize="12sp" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="GESTIÓN" android:textColor="#8C98A4" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/admin_quotes" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:background="@drawable/bg_tarjeta_interactiva" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:padding="14dp" android:text="▤   Gestión de cotizaciones   ›" android:textColor="#FFFFFF" android:textSize="13sp" />
            <TextView android:id="@+id/admin_reports" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:background="@drawable/bg_tarjeta_interactiva" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:padding="14dp" android:text="♙   Reportes   ›" android:textColor="#FFFFFF" android:textSize="13sp" />
            <TextView android:id="@+id/admin_users" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:background="@drawable/bg_tarjeta_interactiva" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:padding="14dp" android:text="⚙   Usuarios   ›" android:textColor="#FFFFFF" android:textSize="13sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="ÚLTIMAS COTIZACIONES" android:textColor="#8C98A4" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_tarjeta" android:padding="12dp" android:text="FERRETERÍA CENTRAL S.A. · $28,500.00&#10;CONSTRUCTORA DEL NORTE · $18,945.00" android:textColor="#F0821E" android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:background="#0A0F14" android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/nav_inicio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Inicio" android:textColor="#F0821E" android:textSize="10sp" />
        <TextView android:id="@+id/nav_cotizaciones" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Cotizaciones" android:textColor="#8C98A4" android:textSize="10sp" />
        <TextView android:id="@+id/nav_reportes" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Reportes" android:textColor="#8C98A4" android:textSize="10sp" />
        <TextView android:id="@+id/nav_usuarios" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Usuarios" android:textColor="#8C98A4" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
