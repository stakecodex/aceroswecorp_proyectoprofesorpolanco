<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <Button
            android:id="@+id/screen_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:backgroundTint="#1B252E"
            android:contentDescription="@string/back"
            android:text="@string/back_arrow"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="H  ACEROS WE-CORP" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="12dp" android:background="#F2B705" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Menú Administrador" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="68dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="#1B252E" android:gravity="center_vertical" android:padding="12dp" android:text="18&#10;Cotizaciones pendientes" android:textColor="#D95708" android:textSize="12sp" />
                <TextView android:layout_width="0dp" android:layout_height="68dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="#1B252E" android:gravity="center_vertical" android:padding="12dp" android:text="4&#10;Usuarios activos" android:textColor="#F2B705" android:textSize="12sp" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="GESTIÓN" android:textColor="#AAB4BC" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/admin_quotes" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:background="#1B252E" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:padding="14dp" android:text="▤   Gestión de cotizaciones   ›" android:textColor="#FFFFFF" android:textSize="13sp" />
            <TextView android:id="@+id/admin_reports" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:background="#1B252E" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:padding="14dp" android:text="♙   Reportes   ›" android:textColor="#FFFFFF" android:textSize="13sp" />
            <TextView android:id="@+id/admin_users" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:background="#1B252E" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:padding="14dp" android:text="⚙   Usuarios   ›" android:textColor="#FFFFFF" android:textSize="13sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="ÚLTIMAS COTIZACIONES" android:textColor="#AAB4BC" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#1B252E" android:padding="12dp" android:text="FERRETERÍA CENTRAL S.A. · $28,500.00&#10;CONSTRUCTORA DEL NORTE · $18,945.00" android:textColor="#F2B705" android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:background="#141D25" android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/nav_inicio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Inicio" android:textColor="#F2B705" android:textSize="10sp" />
        <TextView android:id="@+id/nav_cotizaciones" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Cotizaciones" android:textColor="#AAB4BC" android:textSize="10sp" />
        <TextView android:id="@+id/nav_reportes" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Reportes" android:textColor="#AAB4BC" android:textSize="10sp" />
        <TextView android:id="@+id/nav_usuarios" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Usuarios" android:textColor="#AAB4BC" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
