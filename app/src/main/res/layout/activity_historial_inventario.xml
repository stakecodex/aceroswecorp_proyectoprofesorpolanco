<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10161D"
    android:orientation="vertical">

    <include layout="@layout/include_screen_header" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:text="HISTORIAL DE INVENTARIO"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <EditText android:layout_width="match_parent" android:layout_height="42dp" android:background="@drawable/bg_campo" android:hint="Buscar por producto o usuario..." android:padding="10dp" android:textColor="#FFFFFF" android:textColorHint="#6F7C89" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Spinner android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/bg_campo" android:prompt="@string/all_inventory_movements" />
                <Spinner android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/bg_campo" android:prompt="@string/last_30_days" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="10dp" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/bg_tarjeta" android:gravity="center" android:text="+432&#10;Entradas" android:textColor="#52D273" android:textSize="11sp" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/bg_tarjeta" android:gravity="center" android:text="-287&#10;Salidas" android:textColor="#C2570E" android:textSize="11sp" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/bg_tarjeta" android:gravity="center" android:text="9&#10;Ajustes" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_tarjeta" android:padding="12dp" android:text="Varilla corrugada 3/8”&#10;Entrada · Compra proveedor · Juan Pérez&#10;04/06/2026 · 120 piezas · +120" android:textColor="#D6DCE0" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_tarjeta" android:padding="12dp" android:text="Lámina galvanizada cal. 26&#10;Salida · Venta · Ana López&#10;03/06/2026 · 15 piezas · -15" android:textColor="#D6DCE0" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_tarjeta" android:padding="12dp" android:text="Ángulo de acero 1 1/2”&#10;Ajuste · Conteo físico · Juan Pérez&#10;02/06/2026 · 3 piezas · -3" android:textColor="#D6DCE0" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_tarjeta" android:padding="12dp" android:text="Canal monten 4”&#10;Entrada · Compra proveedor · Ana López&#10;01/06/2026 · 40 piezas · +40" android:textColor="#D6DCE0" android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:background="#0A0F14" android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/nav_inicio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Inicio" android:textColor="#8C98A4" android:textSize="11sp" />
        <TextView android:id="@+id/nav_cotizaciones" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Cotizaciones" android:textColor="#8C98A4" android:textSize="11sp" />
        <TextView android:id="@+id/nav_inventario" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Inventario" android:textColor="#F0821E" android:textSize="11sp" />
        <TextView android:id="@+id/nav_reportes" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Reportes" android:textColor="#8C98A4" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
