<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/screen_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:backgroundTint="#1B252E"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:scaleType="center"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="start|center_vertical"
            android:text="HISTORIAL DE INVENTARIO"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="4dp" android:background="#F2B705" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <EditText android:layout_width="match_parent" android:layout_height="42dp" android:background="#1B252E" android:hint="Buscar por producto o usuario..." android:padding="10dp" android:textColor="#FFFFFF" android:textColorHint="#78848D" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Spinner android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="#1B252E" android:prompt="@string/all_inventory_movements" />
                <Spinner android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="#1B252E" android:prompt="@string/last_30_days" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="10dp" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="#1B252E" android:gravity="center" android:text="+432&#10;Entradas" android:textColor="#52D273" android:textSize="11sp" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="#1B252E" android:gravity="center" android:text="-287&#10;Salidas" android:textColor="#D95708" android:textSize="11sp" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="#1B252E" android:gravity="center" android:text="9&#10;Ajustes" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="#1B252E" android:padding="12dp" android:text="Varilla corrugada 3/8”&#10;Entrada · Compra proveedor · Juan Pérez&#10;04/06/2026 · 120 piezas · +120" android:textColor="#D6DCE0" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#1B252E" android:padding="12dp" android:text="Lámina galvanizada cal. 26&#10;Salida · Venta · Ana López&#10;03/06/2026 · 15 piezas · -15" android:textColor="#D6DCE0" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#1B252E" android:padding="12dp" android:text="Ángulo de acero 1 1/2”&#10;Ajuste · Conteo físico · Juan Pérez&#10;02/06/2026 · 3 piezas · -3" android:textColor="#D6DCE0" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#1B252E" android:padding="12dp" android:text="Canal monten 4”&#10;Entrada · Compra proveedor · Ana López&#10;01/06/2026 · 40 piezas · +40" android:textColor="#D6DCE0" android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:background="#141D25" android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/nav_inicio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Inicio" android:textColor="#AAB4BC" android:textSize="11sp" />
        <TextView android:id="@+id/nav_cotizaciones" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Cotizaciones" android:textColor="#AAB4BC" android:textSize="11sp" />
        <TextView android:id="@+id/nav_inventario" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Inventario" android:textColor="#F2B705" android:textSize="11sp" />
        <TextView android:id="@+id/nav_reportes" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Reportes" android:textColor="#AAB4BC" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
