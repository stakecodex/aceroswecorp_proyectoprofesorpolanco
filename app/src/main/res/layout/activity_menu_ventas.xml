<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#101820"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="H  ACEROS WE-CORP"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:background="#F2B705" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Menú Ventas"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACCESOS"
                android:textColor="#AAB4BC"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_new_quote"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#D95708"
                android:gravity="start|center_vertical"
                android:text="＋  NUEVA COTIZACIÓN"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_inventory"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#1B252E"
                android:gravity="start|center_vertical"
                android:text="⌕  CONSULTA INVENTARIO"
                android:textColor="#F2B705"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_my_quotes"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#1B252E"
                android:gravity="start|center_vertical"
                android:text="▤  MIS COTIZACIONES"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="GESTIÓN DE CLIENTES"
                android:textColor="#AAB4BC"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_clients"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#1B252E"
                android:gravity="start|center_vertical"
                android:text="♙  CLIENTES"
                android:textColor="#FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="#1B252E"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:text="3\nCotizaciones del día"
                    android:textColor="#F2B705"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="#1B252E"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:text="1\nPendiente"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#141D25"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView android:id="@+id/nav_inicio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Inicio" android:textColor="#F2B705" android:textSize="11sp" />
        <TextView android:id="@+id/nav_clientes" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Clientes" android:textColor="#AAB4BC" android:textSize="11sp" />
        <TextView android:id="@+id/nav_inventario" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Inventario" android:textColor="#AAB4BC" android:textSize="11sp" />
        <TextView android:id="@+id/nav_cotizaciones" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Cotizaciones" android:textColor="#AAB4BC" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
