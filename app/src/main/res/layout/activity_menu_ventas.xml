<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10161D"
    android:orientation="vertical">

    <include layout="@layout/include_screen_header" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:text="Menú Ventas"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACCESOS"
                android:textColor="#8C98A4"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_new_quote"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#C2570E"
                android:gravity="start|center_vertical"
                android:text="＋  NUEVA COTIZACIÓN"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_inventory"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#1A222B"
                android:gravity="start|center_vertical"
                android:text="⌕  CONSULTA INVENTARIO"
                android:textColor="#F0821E"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_my_quotes"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#1A222B"
                android:gravity="start|center_vertical"
                android:text="▤  MIS COTIZACIONES"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="GESTIÓN DE CLIENTES"
                android:textColor="#8C98A4"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_clients"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#1A222B"
                android:gravity="start|center_vertical"
                android:text="♙  CLIENTES"
                android:textColor="#FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tarjeta"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:text="3\nCotizaciones del día"
                    android:textColor="#F0821E"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tarjeta"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:text="1\nPendiente"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0A0F14"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView android:id="@+id/nav_inicio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Inicio" android:textColor="#F0821E" android:textSize="10sp" />
        <TextView android:id="@+id/nav_clientes" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Clientes" android:textColor="#8C98A4" android:textSize="10sp" />
        <TextView android:id="@+id/nav_inventario" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Inventario" android:textColor="#8C98A4" android:textSize="10sp" />
        <TextView android:id="@+id/nav_cotizaciones" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Cotizaciones" android:textColor="#8C98A4" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
